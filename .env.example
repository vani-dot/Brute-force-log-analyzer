# Copy to .env and fill in what you want to use.
# Anything left blank simply disables that feature — nothing breaks, and the
# web UI shows it as "not configured" rather than pretending to work.

# ─── Live log monitoring ────────────────────────────────────────────
# The log file to follow in real time.
#   Linux:  /var/log/auth.log   (Debian/Ubuntu)
#           /var/log/secure     (RHEL/Fedora)
#   macOS:  no plain-text sshd log; generate one first with
#           log show --predicate 'process == "sshd"' --last 1h > ~/auth.log
BFLA_WATCH_PATH=

# ─── Geo / ASN enrichment ───────────────────────────────────────────
# Free GeoLite2 databases from https://www.maxmind.com (sign up, then
# download GeoLite2-City.mmdb and GeoLite2-ASN.mmdb). Also needs:
#   pip install geoip2
# Without these, IPs are still classified (private / documentation /
# public) from the address itself — no invented locations.
BFLA_GEOIP_CITY_DB=
BFLA_GEOIP_ASN_DB=

# Reverse DNS on offending IPs. Off by default: it is a network call per
# address and leaks which IPs you are looking at.
BFLA_REVERSE_DNS=false

# ─── Alert delivery ─────────────────────────────────────────────────
# Slack: create an app, enable Incoming Webhooks, paste the URL.
BFLA_SLACK_WEBHOOK_URL=

# Any HTTP endpoint. Receives the finding as JSON.
BFLA_WEBHOOK_URL=

# Email
BFLA_SMTP_HOST=
BFLA_SMTP_PORT=587
BFLA_SMTP_USER=
BFLA_SMTP_PASSWORD=
BFLA_SMTP_TLS=true
BFLA_MAIL_FROM=
BFLA_MAIL_TO=

# Only alert at this severity or above. HIGH or MEDIUM.
BFLA_ALERT_MIN_SEVERITY=HIGH
# Do not re-alert on the same key within this many seconds.
BFLA_ALERT_COOLDOWN=900

# Never alert on these. Comma separated: CIDRs, single addresses, or
# usernames. Put your own office/VPN range here — the subnet pivot cannot
# know which network is yours, and every staff typo aggregates into it.
#   e.g. BFLA_ALLOWLIST=10.0.0.0/8,192.168.0.0/16,backup
BFLA_ALLOWLIST=

# ─── Detection ──────────────────────────────────────────────────────
# Blank uses the measured defaults baked into detector.py.
BFLA_THRESHOLD=
BFLA_WINDOW=

# ─── Storage ────────────────────────────────────────────────────────
BFLA_DB_PATH=
BFLA_PERSIST=true

# ─── Web ────────────────────────────────────────────────────────────
PORT=5000
BFLA_DEBUG=true
